{
  "masters": {
    "SBRM_USER": {
      "code": "SBRM_USER",
      "title": "使用者设定",
      "table": "users",
      "keyField": "USER_KEY",
      "idField": "USER_ID",
      "uniqueFields": [
        "USER_ID"
      ],
      "desc": "维护使用者基本资料与 Email 通知地址。",
      "fields": [
        {
          "name": "USER_ID",
          "label": "使用者代码",
          "type": "text",
          "required": true,
          "readOnlyOnEdit": true,
          "width": 110,
          "filter": true
        },
        {
          "name": "USER_NAME",
          "label": "使用者名称",
          "type": "text",
          "required": true,
          "width": 130,
          "filter": true
        },
        {
          "name": "LAST_NAME",
          "label": "使用者姓",
          "type": "text",
          "grid": true
        },
        {
          "name": "FIRST_NAME",
          "label": "使用者名",
          "type": "text",
          "grid": true
        },
        {
          "name": "MIDDLE_NAME",
          "label": "中间名",
          "type": "text"
        },
        {
          "name": "IPPHONE_IM",
          "label": "IPPhone(IM)",
          "type": "text"
        },
        {
          "name": "IPPHONE_EXT",
          "label": "IPPhone(分机)",
          "type": "text"
        },
        {
          "name": "ALARM_SMS_PHONE",
          "label": "警报短信电话",
          "type": "text"
        },
        {
          "name": "ALARM_PHONE",
          "label": "警报电话",
          "type": "text"
        },
        {
          "name": "HIRE_DATE",
          "label": "到职日",
          "type": "date"
        },
        {
          "name": "IS_EMPLOYEE",
          "label": "是否公司员工",
          "type": "checkbox"
        },
        {
          "name": "GENDER",
          "label": "性别",
          "type": "select",
          "optionSet": "gender",
          "grid": true
        },
        {
          "name": "PASSWORD",
          "label": "密码",
          "type": "password",
          "grid": false,
          "requiredOnCreate": true,
          "help": "新增时必填；修改时留空保留原密码"
        },
        {
          "name": "E_MAIL",
          "label": "E-Mail",
          "type": "text",
          "width": 210,
          "filter": true
        },
        {
          "name": "PHONE",
          "label": "电话",
          "type": "text",
          "grid": false
        },
        {
          "name": "MOBILE",
          "label": "Mobile",
          "type": "text",
          "grid": false
        },
        {
          "name": "TITLE",
          "label": "职称",
          "type": "text",
          "width": 130
        },
        {
          "name": "SHIFT_KEY",
          "label": "班别",
          "type": "select",
          "optionSet": "shift",
          "width": 90
        },
        {
          "name": "ORGAN_KEY",
          "label": "部门",
          "type": "select",
          "optionSet": "department",
          "width": 150,
          "filter": true
        }
      ],
      "filters": [
        "USER_ID",
        "USER_NAME",
        "E_MAIL",
        "ORGAN_KEY"
      ],
      "defaults": {
        "SHIFT_KEY": "A",
        "GENDER": "M"
      }
    },
    "SBRM_FACTORY": {
      "code": "SBRM_FACTORY",
      "title": "厂别设定",
      "table": "factories",
      "keyField": "FACTORY_KEY",
      "idField": "FACTORY_ID",
      "uniqueFields": [
        "FACTORY_ID"
      ],
      "desc": "厂别是警报四要素之一，用于区分各厂警报与事件。",
      "fields": [
        {
          "name": "FACTORY_ID",
          "label": "厂别代码",
          "type": "text",
          "required": true,
          "readOnlyOnEdit": true,
          "width": 170,
          "filter": true
        },
        {
          "name": "FACTORY_NAME",
          "label": "厂别名称",
          "type": "text",
          "required": true,
          "width": 190,
          "filter": true
        },
        {
          "name": "FACTORY_DESC",
          "label": "厂别说明",
          "type": "text",
          "width": 260
        }
      ],
      "filters": [
        "FACTORY_ID",
        "FACTORY_NAME"
      ]
    },
    "SBRM_EQP": {
      "code": "SBRM_EQP",
      "title": "机台设定",
      "table": "eqps",
      "keyField": "EQP_KEY",
      "idField": "EQP_ID",
      "uniqueFields": [
        "EQP_ID"
      ],
      "desc": "维护机台代码、名称与说明，供警报四要素匹配。",
      "fields": [
        {
          "name": "EQP_ID",
          "label": "机台代码",
          "type": "text",
          "required": true,
          "readOnlyOnEdit": true,
          "width": 130,
          "filter": true
        },
        {
          "name": "EQP_NAME",
          "label": "机台名称",
          "type": "text",
          "required": true,
          "width": 180,
          "filter": true
        },
        {
          "name": "EQP_DESC",
          "label": "机台说明",
          "type": "text",
          "width": 240
        }
      ],
      "filters": [
        "EQP_ID",
        "EQP_NAME"
      ]
    },
    "AVMA003": {
      "code": "AVMA003",
      "title": "子系统设定",
      "table": "subsystems",
      "keyField": "SUB_SYS_KEY",
      "idField": "SUB_SYS_ID",
      "uniqueFields": [
        "SUB_SYS_ID"
      ],
      "desc": "厂别下的系统维度（EAP／FDC／MES／SPC／EDC…）。支持 BYPASS 只留 Log 不发送。",
      "fields": [
        {
          "name": "SUB_SYS_ID",
          "label": "子系统代码",
          "type": "text",
          "required": true,
          "readOnlyOnEdit": true,
          "width": 120,
          "filter": true
        },
        {
          "name": "SUB_SYS_NAME",
          "label": "子系统名称",
          "type": "text",
          "required": true,
          "width": 220,
          "filter": true
        },
        {
          "name": "BYPASS",
          "label": "BYPASS",
          "type": "checkbox",
          "help": "启用后警报只留 Log，不发送通知"
        }
      ],
      "filters": [
        "SUB_SYS_ID",
        "SUB_SYS_NAME"
      ]
    },
    "AVMA009": {
      "code": "AVMA009",
      "title": "警报通知设定",
      "table": "alarm_settings",
      "keyField": "ALARM_INFO_KEY",
      "idField": "ALARM_INFO_ID",
      "uniqueFields": [],
      "uniqueComposite": [
        [
          "FACTORY_KEY",
          "SUB_SYS_KEY",
          "EQP_KEY",
          "ALARM_INFO_ID"
        ]
      ],
      "desc": "绑定厂别／子系统／机台／警报代码到事件通知；四要素不可完全相同。",
      "fields": [
        {
          "name": "ALARM_INFO_ID",
          "label": "警报代码",
          "type": "text",
          "required": true,
          "readOnlyOnEdit": true,
          "width": 150,
          "filter": true
        },
        {
          "name": "ALARM_ID_DESC",
          "label": "警报说明",
          "type": "text",
          "required": true,
          "width": 220,
          "filter": true
        },
        {
          "name": "FACTORY_KEY",
          "label": "厂别",
          "type": "select",
          "optionSet": "factory",
          "width": 180,
          "filter": true,
          "required": true
        },
        {
          "name": "SUB_SYS_KEY",
          "label": "子系统",
          "type": "select",
          "optionSet": "subsystem",
          "width": 180,
          "filter": true,
          "required": true,
          "dependsOn": "FACTORY_KEY"
        },
        {
          "name": "EQP_KEY",
          "label": "机台",
          "type": "select",
          "optionSet": "eqpWithAny",
          "required": true,
          "width": 150
        },
        {
          "name": "EVENT_KEY",
          "label": "通知事件",
          "type": "select",
          "optionSet": "event",
          "width": 200,
          "filter": true,
          "required": true
        },
        {
          "name": "EVENT_PTY_ID",
          "label": "优先权代码",
          "type": "number",
          "width": 110,
          "required": true,
          "integer": true,
          "min": 0
        },
        {
          "name": "IGNORE_PERIOD",
          "label": "忽略相同警报时间间隔(秒)",
          "type": "number",
          "width": 190,
          "help": "默认 900 秒",
          "required": true,
          "integer": true,
          "min": 0
        },
        {
          "name": "ALARM_CMT",
          "label": "备注",
          "type": "text",
          "grid": true
        }
      ],
      "filters": [
        "ALARM_INFO_ID",
        "ALARM_ID_DESC",
        "FACTORY_KEY",
        "SUB_SYS_KEY",
        "EQP_KEY"
      ],
      "defaults": {
        "IGNORE_PERIOD": 900,
        "EVENT_PTY_ID": 5,
        "EQP_KEY": "*"
      }
    },
    "SBRM_USERGROUP": {
      "code": "SBRM_USERGROUP",
      "title": "使用者群组管理",
      "table": "user_groups",
      "keyField": "GROUP_KEY",
      "idField": "GROUP_ID",
      "uniqueFields": [
        "GROUP_ID"
      ],
      "uniqueIgnoreCase": [
        "GROUP_ID"
      ],
      "desc": "维护使用者群组基本资料；本期群组仅作为基础资料，不参与登录鉴权或功能权限。",
      "fields": [
        {
          "name": "GROUP_ID",
          "label": "GROUP_ID",
          "type": "text",
          "required": true,
          "readOnlyOnEdit": true,
          "width": 170,
          "filter": true
        },
        {
          "name": "GROUP_NAME",
          "label": "GROUP_NAME",
          "type": "text",
          "required": true,
          "width": 190,
          "filter": true
        },
        {
          "name": "GROUP_DESC",
          "label": "GROUP_DESC",
          "type": "text",
          "width": 260
        }
      ],
      "filters": [
        "GROUP_ID",
        "GROUP_NAME"
      ]
    }
  },
  "mappings": {
    "AVMA004": {
      "code": "AVMA004",
      "title": "厂别子系统对应设定",
      "desc": "维护厂别与子系统多对多对应关系。",
      "master": {
        "table": "factories",
        "key": "FACTORY_KEY",
        "label": "厂别",
        "display": [
          "FACTORY_ID",
          "FACTORY_NAME"
        ]
      },
      "item": {
        "table": "subsystems",
        "key": "SUB_SYS_KEY",
        "label": "子系统",
        "display": [
          "SUB_SYS_ID",
          "SUB_SYS_NAME"
        ]
      },
      "mapTable": "factory_subsys",
      "mapMasterFk": "FACTORY_KEY",
      "mapItemFk": "SUB_SYS_KEY",
      "masterColumns": [
        "FACTORY_ID",
        "FACTORY_NAME",
        "FACTORY_DESC"
      ],
      "itemColumns": [
        "SUB_SYS_ID",
        "SUB_SYS_NAME",
        "BYPASS"
      ]
    },
    "SBRM_USERGROUP_MAP": {
      "code": "SBRM_USERGROUP_MAP",
      "title": "群组使用者对应管理",
      "desc": "左侧选择群组，右侧维护群组成员；保存以本次清单整组替换，不参与权限或通知派报。",
      "master": {
        "table": "user_groups",
        "key": "GROUP_KEY",
        "label": "使用者群组",
        "display": [
          "GROUP_ID",
          "GROUP_NAME",
          "GROUP_DESC"
        ],
        "excelHeader": "GROUP_ID"
      },
      "item": {
        "table": "users",
        "key": "USER_KEY",
        "label": "使用者",
        "display": [
          "USER_ID",
          "USER_NAME"
        ],
        "excelHeader": "USER_ID"
      },
      "mapTable": "user_group_users",
      "mapMasterFk": "GROUP_KEY",
      "mapItemFk": "USER_KEY",
      "masterColumns": [
        "GROUP_ID",
        "GROUP_NAME",
        "GROUP_DESC"
      ],
      "itemColumns": [
        "USER_ID",
        "USER_NAME"
      ]
    }
  },
  "masterDetails": {
    "AVMA007": {
      "code": "AVMA007",
      "title": "事件通知设定",
      "desc": "各层级直接选择通知人员；Email 通知，按 ACK 人数、升级间隔与失败重送策略处理。",
      "masterTable": "events",
      "masterKey": "EVENT_KEY",
      "masterId": "EVENT_ID",
      "defaults": {
        "EVENT_PRIORITY_ID": 5
      },
      "masterUnique": [
        [
          "EVENT_ID"
        ]
      ],
      "fields": [
        {
          "name": "EVENT_ID",
          "label": "事件通知代码",
          "type": "text",
          "required": true,
          "readOnlyOnEdit": true,
          "width": 180,
          "filter": true
        },
        {
          "name": "EVENT_NAME",
          "label": "事件通知名称",
          "type": "text",
          "required": true,
          "width": 210,
          "filter": true
        },
        {
          "name": "FACTORY_KEY",
          "label": "厂别",
          "type": "select",
          "optionSet": "factory",
          "width": 180,
          "filter": true,
          "readOnlyOnEdit": true,
          "required": true
        },
        {
          "name": "SUB_SYS_KEY",
          "label": "子系统",
          "type": "select",
          "optionSet": "subsystem",
          "width": 180,
          "filter": true,
          "readOnlyOnEdit": true,
          "required": true,
          "dependsOn": "FACTORY_KEY"
        },
        {
          "name": "EVENT_DESC",
          "label": "事件通知说明",
          "type": "text",
          "width": 240
        },
        {
          "name": "EVENT_PRIORITY_ID",
          "label": "优先权代码",
          "type": "number",
          "width": 110,
          "required": true,
          "integer": true,
          "min": 0
        }
      ],
      "filters": [
        "EVENT_ID",
        "EVENT_NAME",
        "FACTORY_KEY",
        "SUB_SYS_KEY"
      ],
      "detail": {
        "mode": "grid",
        "table": "event_levels",
        "fk": "EVENT_KEY",
        "key": "EVENT_LEVEL_KEY",
        "title": "事件层级",
        "idField": "EVENT_LEVEL_ID",
        "fields": [
          {
            "name": "EVENT_LEVEL_ID",
            "label": "事件层级代码",
            "type": "number",
            "width": 110,
            "required": true,
            "integer": true,
            "min": 1
          },
          {
            "name": "EVENT_LEVEL_DESC",
            "label": "事件层级说明",
            "type": "text",
            "width": 170
          },
          {
            "name": "NUMBER_OF_ACK_USERS",
            "label": "需要回应的人数",
            "type": "text",
            "width": 130,
            "help": "0=不需回应，*=全员",
            "required": true
          },
          {
            "name": "LEVEL_INTERVAL",
            "label": "升级层级时间间隔(分)",
            "type": "number",
            "width": 170,
            "required": true,
            "integer": true,
            "min": 1
          },
          {
            "name": "FAIL_RETRY_TIMES",
            "label": "失败重送次数",
            "type": "number",
            "width": 120,
            "required": true,
            "integer": true,
            "min": 0
          },
          {
            "name": "FAIL_RETRY_INTERVAL",
            "label": "失败重送时间间隔(秒)",
            "type": "number",
            "width": 170,
            "required": true,
            "integer": true,
            "min": 0
          }
        ]
      }
    }
  },
